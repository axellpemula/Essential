{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "es:waystone_sandstone",
            "menu_category": {
                "category": "construction"
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:cardinal_direction"],
                    "y_rotation_offset": 180
                }
            },
            "states": {
                "es:half": ["bottom", "top"],
                "es:rune_color": [
                    "light_blue",
                    "black",
                    "blue",
                    "brown",
                    "cyan",
                    "gray",
                    "green",
                    "white",
                    "light_gray",
                    "lime",
                    "magenta",
                    "orange",
                    "pink",
                    "purple",
                    "red",
                    "yellow"
                ]
            }
        },
        "components": {
            "tag:minecraft:is_pickaxe_item_destructible": {},
            "tag:minecraft:stone_tier_destructible": {},
            "tag:minecraft:diamond_tier_destructible": {},
            "tag:minecraft:golden_tier_destructible": {},
            "tag:minecraft:iron_tier_destructible": {},
            "tag:minecraft:wooden_tier_destructible": {},
            "tag:minecraft:netherite_tier_destructible": {},
            "minecraft:destructible_by_explosion": false,
            "minecraft:movable": {
                "movement_type": "immovable",
                "sticky": "none"
            },
            "minecraft:geometry": {
                "identifier": "geometry.waystone"
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "opaque",
                    "texture": "cut_sandstone"
                }
            },
            "tag:es:waystone": {},
            "minecraft:collision_box": true,
            "es:waystone": {},
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:display_name": "Waystone Sandstone",
            "minecraft:loot": "loot_tables/air.loot.json"
        },
        "permutations": [
            {
                "condition": "q.block_state('es:half') == 'top'",
                "components": {
                    "minecraft:geometry": {
                        "identifier": "geometry.waystone_top"
                    },
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "alpha_test",
                            "texture": "waystone_runes_white"
                        }
                    },
                    "tag:half_top": {},
                    "minecraft:placement_filter": {
                        "conditions": [
                            {
                                "allowed_faces": ["up"],
                                "block_filter": [
                                    {
                                        "tags": "q.any_tag('es:waystone')"
                                    }
                                ]
                            }
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [-8, 0, -8],
                        "size": [16, 14, 16]
                    },
                    "minecraft:selection_box": {
                        "origin": [-8, 0, -8],
                        "size": [16, 14, 16]
                    },
                    "minecraft:loot": "loot_tables/air.loot.json"
                }
            },
            {
                "condition": "q.block_state('es:rune_color') == 'black' && q.block_state('es:half') == 'top'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "alpha_test",
                            "texture": "waystone_runes_black"
