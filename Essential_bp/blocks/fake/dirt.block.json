{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "es:fake_dirt",
            "menu_category": {
                "category": "construction"
            },
            "states": {
                "es:fake_block_on": [false, true]
            }
        },
        "components": {
            "minecraft:geometry": "minecraft:geometry.full_block",
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test_single_sided",
                    "texture": "dirt",
                    "ambient_occlusion": true,
                    "face_dimming": true
                }
            },
            "minecraft:light_dampening": 15,
            "minecraft:redstone_conductivity": {
                "allows_wire_to_step_down": true,
                "redstone_conductor": true
            },
            "minecraft:selection_box": true,

            "es:fake_block": {},
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:tick": {
                "interval_range": [20, 20],
                "looping": true
            },
            "tag:minecraft:is_shovel_item_destructible": {},
            "minecraft:display_name": "Fake Dirt"
        },
        "permutations": [
            {
                "condition": "q.block_state('es:fake_block_on') == true",
                "components": {
                    "minecraft:collision_box": true
                }
            },
            {
                "condition": "q.block_state('es:fake_block_on') == false",
                "components": {
                    "minecraft:collision_box": false
                }
            }
        ]
    }
}
