{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "es:fake_crimson_log",
            "menu_category": {
                "category": "construction"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            },
            "states": {
                "es:fake_block_on": [
                    false,
                    true
                ]
            }
        },
        "components": {
            "minecraft:geometry": "minecraft:geometry.full_block",
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test_single_sided",
                    "texture": "crimson_log_side",
                    "ambient_occlusion": true,
                    "face_dimming": true
                },
                "up": {
                    "render_method": "alpha_test_single_sided",
                    "texture": "crimson_log_top",
                    "ambient_occlusion": true,
                    "face_dimming": true
                },
                "down": {
                    "render_method": "alpha_test_single_sided",
                    "texture": "crimson_log_top",
                    "ambient_occlusion": true,
                    "face_dimming": true
                }
            },
            "minecraft:light_dampening": 15,
            "minecraft:redstone_conductivity": {
                "allows_wire_to_step_down": true,
                "redstone_conductor": true
            },
            "minecraft:selection_box": true,
            "es:fake_block": {},
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:tick": {
                "interval_range": [
                    20,
                    20
                ],
                "looping": true
            },
            "tag:minecraft:is_axe_item_destructible": {},
            "minecraft:display_name": "Fake Crimson Log"
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            -90
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            -90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            90
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:block_face') == 'up' || q.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('es:fake_block_on') == true",
                "components": {
                    "minecraft:collision_box": true
                }
            },
            {
                "condition": "q.block_state('es:fake_block_on') == false",
                "components": {
                    "minecraft:collision_box": false
                }
            }
        ]
    }
}