{
    "format_version": "1.21.50",
    "minecraft:entity": {
        "description": {
            "identifier": "es:healthbar",
            "is_spawnable": false,
            "is_summonable": true,
            "spawn_category": "misc"
        },
        "components": {
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "all",
                        "deals_damage": "no"
                    }
                ]
            },
            "minecraft:despawn": {
                "filters": [
                    {
                        "any_of": [
                            {
                                "test": "distance_to_nearest_player",
                                "operator": ">=",
                                "value": 54
                            }
                        ]
                    }
                ]
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:collision_box": {
                "height": 0,
                "width": 0
            },
            "minecraft:renders_when_invisible": {},
            "minecraft:nameable": {
                "allow_name_tag_renaming": false,
                "always_show": true
            }
        }
    }
}
