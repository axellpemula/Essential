{
    "format_version": "1.21.50",
    "minecraft:entity": {
        "description": {
            "identifier": "es:glowblock",
            "is_spawnable": false,
            "is_summonable": true,
            "spawn_category": "misc",
            "properties": {
                "es:color_index": {
                    "client_sync": true,
                    "type": "int",
                    "default": 0,
                    "range": [0, 10]
                },
                "es:ore_index": {
                    "client_sync": true,
                    "type": "int",
                    "default": 0,
                    "range": [0, 18]
                },
                "es:glow_type": {
                    "client_sync": true,
                    "type": "enum",
                    "default": "box",
                    "values": ["box", "ore", "outline"]
                }
            }
        },
        "component_groups": {
            "es:remove_cr": {
                "minecraft:instant_despawn": {
                    "remove_child_entities": true
                }
            }
        },
        "components": {
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "all",
                        "deals_damage": "no"
                    }
                ]
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:collision_box": {
                "height": 0,
                "width": 0
            },
            "minecraft:block_sensor": {
                "sensor_radius": 1,
                "on_break": [
                    {
                        "on_block_broken": "ct:d",
                        "block_list": [
                            "minecraft:coal_ore",
                            "minecraft:deepslate_coal_ore",
                            "minecraft:iron_ore",
                            "minecraft:deepslate_iron_ore",
                            "minecraft:gold_ore",
                            "minecraft:deepslate_gold_ore",
                            "minecraft:diamond_ore",
                            "minecraft:deepslate_diamond_ore",
                            "minecraft:emerald_ore",
                            "minecraft:deepslate_emerald_ore",
                            "minecraft:redstone_ore",
                            "minecraft:deepslate_redstone_ore",
                            "minecraft:lapis_ore",
                            "minecraft:deepslate_lapis_ore",
                            "minecraft:copper_ore",
                            "minecraft:deepslate_copper_ore",
                            "minecraft:ancient_debris",
                            "minecraft:quartz_ore",
                            "minecraft:nether_gold_ore"
                        ]
                    }
                ]
            },
            "minecraft:renders_when_invisible": {},
            "minecraft:nameable": {
                "allow_name_tag_renaming": false,
                "always_show": true
            }
        },
        "events": {
            "ct:d": {
                "queue_command": {
                    "command": ["event entity @s es:despawn"]
                }
            },
            "es:despawn": {
                "add": {
                    "component_groups": ["es:remove_cr"]
                }
            },
            "es:test": {
                "set_property": {
                    "es:color_index": 10
                }
            }
        }
    }
}
