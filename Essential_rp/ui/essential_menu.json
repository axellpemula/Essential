{
  "namespace": "essential_ui",
  "action_screen": {
    "type": "panel",
    "size": "$essential_form_size",
    "max_size": "$essential_form_size",
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "frame": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/essential/panel",
          "layer": 0
        }
      },
      {
        "title": {
          "type": "label",
          "text": "#essential_title",
          "size": ["100% - 96px", 24],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 31],
          "color": [0.96, 0.84, 0.59],
          "font_scale_factor": 1.05,
          "shadow": true,
          "layer": 5,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - $essential_action_tag)",
              "target_property_name": "#essential_title"
            }
          ]
        }
      },
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 96],
          "size": ["100% - 30px", "100% - 125px"],
          "$show_background": false,
          "$scrolling_content": "essential_ui.action_content",
          "$scroll_size": [4, "100% - 4px"],
          "$scrolling_pane_size": ["100% - 7px", "100% - 2px"],
          "$scrolling_pane_offset": [1, 0],
          "$scroll_bar_right_padding_size": [0, 0]
        }
      },
      {
        "footer_label": {
          "type": "label",
          "text": "ESSENTIAL++  •  SERVER UTILITIES",
          "size": ["100% - 34px", 12],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -10],
          "color": [0.47, 0.67, 0.69],
          "font_scale_factor": 0.65,
          "text_alignment": "center",
          "layer": 5
        }
      }
    ]
  },
  "action_content": {
    "type": "stack_panel",
    "size": ["100% - 6px", "100%c"],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body_text": {
          "type": "label",
          "text": "#form_text",
          "size": ["100%", "default"],
          "offset": [2, 1],
          "color": [0.78, 0.85, 0.88],
          "font_scale_factor": 0.82,
          "shadow": true,
          "layer": 3
        }
      },
      {
        "body_spacing": {
          "type": "panel",
          "size": ["100%", 7]
        }
      },
      {
        "dynamic_buttons": {
          "type": "stack_panel",
          "size": ["100%", "100%c"],
          "orientation": "vertical",
          "factory": {
            "name": "buttons",
            "control_ids": {
              "button": "essential_ui.action_button",
              "label": "@essential_ui.action_label",
              "header": "@essential_ui.action_header",
              "divider": "@essential_ui.action_divider"
            }
          },
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_contents",
              "binding_name_override": "#collection_length"
            }
          ]
        }
      }
    ]
  },
  "action_button": {
    "type": "panel",
    "size": ["100%", 42],
    "controls": [
      {
        "clickable@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": ["100%", "100%"],
          "default_control": "default",
          "hover_control": "hover",
          "pressed_control": "pressed",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            }
          ],
          "controls": [
            { "default@essential_ui.button_default": {} },
            { "hover@essential_ui.button_hover": {} },
            { "pressed@essential_ui.button_pressed": {} },
            {
              "icon": {
                "type": "image",
                "size": [28, 28],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [16, 0],
                "layer": 4,
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "button_label": {
                "type": "label",
                "text": "#text",
                "size": ["100% - 62px", "100%"],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [52, -1],
                "color": [0.89, 0.92, 0.91],
                "font_scale_factor": 0.83,
                "shadow": true,
                "layer": 5,
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "#form_button_text",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "button_default": {
    "type": "image",
    "size": ["100%", "100%"],
    "texture": "textures/ui/essential/button",
    "layer": 1
  },
  "button_hover": {
    "type": "image",
    "size": ["100%", "100%"],
    "texture": "textures/ui/essential/button_hover",
    "layer": 1
  },
  "button_pressed": {
    "type": "image",
    "size": ["100%", "100%"],
    "texture": "textures/ui/essential/button_pressed",
    "layer": 1
  },
  "action_label@settings_common.option_group_spaced_label": {
    "$text": "#form_button_text",
    "$text_bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "action_header@settings_common.option_group_spaced_header": {
    "$text": "#form_button_text",
    "$text_bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "action_divider@settings_common.option_group_section_divider": {},
  "modal_screen": {
    "type": "panel",
    "size": "$essential_form_size",
    "max_size": "$essential_form_size",
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "frame": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/essential/panel",
          "layer": 0
        }
      },
      {
        "title": {
          "type": "label",
          "text": "#essential_title",
          "size": ["100% - 94px", 24],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 31],
          "color": [0.96, 0.84, 0.59],
          "font_scale_factor": 1.0,
          "shadow": true,
          "layer": 5,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - $essential_modal_tag)",
              "target_property_name": "#essential_title"
            }
          ]
        }
      },
      {
        "modal_controls@server_form.custom_form": {
          "size": ["100% - 24px", "100% - 129px"],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 96],
          "$title_panel": "common.empty_panel",
          "$title_size": [0, 0],
          "$title_max_size": [0, 0],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "layer": 3
        }
      }
    ]
  }
}
